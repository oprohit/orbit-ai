# ── ORBIT AI environment ────────────────────────────────────
# Database (PostgreSQL / Supabase). RLS enabled at deploy time.
DATABASE_URL=postgresql://user:password@host:5432/app_db

# Optional AI routing layer (OpenRouter). If unset, Orbit runs its
# deterministic local planner. The model is advisory only — every tool
# request still passes the central policy engine.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=anthropic/claude-3.5-haiku

# Mobile (Capacitor) base URL
NEXT_PUBLIC_ORBIT_URL=

# ── Production OAuth (never committed) ──────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
